FROM mcr.microsoft.com/playwright/python:v1.62.0-noble

RUN groupadd --gid 82 report-engine \
    && useradd --uid 82 --gid 82 --create-home --shell /usr/sbin/nologin report-engine

WORKDIR /engine
COPY report-engine/ .
RUN pip install --no-cache-dir ".[render]" \
    && mkdir -p /reports \
    && chown -R report-engine:report-engine /engine /reports

USER report-engine
CMD ["uvicorn", "api:app", "--host=0.0.0.0", "--port=8000", "--workers=2", "--proxy-headers", "--forwarded-allow-ips=*"]

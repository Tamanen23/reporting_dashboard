{
  "status": "proposed_blocked_pending_source_and_recognition_decisions",
  "code": "cash_operations_dashboard",
  "name": "Betnabiso Cash Operations Dashboard",
  "description": "Settled betting turnover, winning payments, GGR and operational ratios.",
  "definition_version": "1.0.0-draft.1",
  "calculation_version": "1.0.0-draft.1",
  "template_version": "1.0.0-draft.1",
  "reporting_period_type": "date_range",
  "outputs": ["pdf", "png", "json", "prepared_dataset", "validation_log", "reconciliation_report", "manifest"],
  "processor": "reports.cash_operations_dashboard.v1.report.CashOperationsDashboardReport",
  "template": "reports/cash_operations_dashboard/v1/templates/dashboard.html",
  "display_order": 30,
  "timeout_seconds": 1200,
  "retention_days": 365,
  "allowed_roles": ["admin", "report_user"],
  "inputs": [
    {
      "key": "cash_operations",
      "kind": "uploaded_workbook",
      "label": "Cash Operations Detailed Logs workbook",
      "required": true,
      "accepted_extensions": ["xlsx"],
      "accepted_mime_types": ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"],
      "worksheet": {"selector": "pending_source_inspection"},
      "canonical_required_fields": ["player_id", "username", "slip_id", "bet_date", "status", "stake", "payout"],
      "source_column_mapping": "pending_source_inspection"
    }
  ],
  "prepared_datasets": [{"key": "betting_dataset", "format": "parquet", "grain": "pending_workbook_grain_and_deduplication_decision", "schema_version": "1.0.0-draft.1"}],
  "configuration": {
    "timezone": "Indian/Mauritius",
    "include_report_date": null,
    "excluded_dates": [],
    "test_account_rule": {"field": "username", "operator": "contains_case_insensitive", "value": "test"},
    "valid_settled_statuses": null,
    "void_handling": null,
    "cancelled_handling": null,
    "refunded_handling": null,
    "recognition_date": null,
    "winning_paid_count_rule": null,
    "withholding_tax_source": null,
    "deduplication_key": null,
    "rounding": {"currency_scale": 2, "percentage_scale": 2, "mode": "ROUND_HALF_UP"}
  },
  "rendering": {
    "pdf": {"page_size": "A3", "orientation": "landscape", "print_background": true},
    "png": {"width": 2560, "height": 1440, "device_scale_factor": 2},
    "theme": "betnabiso_dark_gold_v1"
  }
}

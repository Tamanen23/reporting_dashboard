{
  "status": "proposed_blocked_pending_source_and_segmentation_decisions",
  "code": "player_activity_retention_dashboard",
  "name": "Betnabiso Player Activity and Retention Dashboard",
  "description": "Player journey, frequency, mutually exclusive activity segments, retention and value groups.",
  "definition_version": "1.0.0-draft.1",
  "calculation_version": "1.0.0-draft.1",
  "template_version": "1.0.0-draft.1",
  "reporting_period_type": "date_range",
  "outputs": ["pdf", "png", "json", "prepared_dataset", "validation_log", "reconciliation_report", "manifest"],
  "processor": "reports.player_activity_retention_dashboard.v1.report.PlayerActivityRetentionDashboardReport",
  "template": "reports/player_activity_retention_dashboard/v1/templates/dashboard.html",
  "display_order": 40,
  "timeout_seconds": 1800,
  "retention_days": 365,
  "allowed_roles": ["admin", "report_user"],
  "inputs": [
    {"key": "registration_dataset", "kind": "prepared_dataset", "required": true, "source_report_code": "registration_dashboard", "source_artifact_key": "registration_dataset", "period_compatibility": "exact"},
    {"key": "payment_dataset", "kind": "prepared_dataset", "required": true, "source_report_code": "deposits_withdrawals_bonus_dashboard", "source_artifact_key": "payment_dataset", "period_compatibility": "exact"},
    {"key": "bonus_dataset", "kind": "prepared_dataset", "required": false, "source_report_code": "deposits_withdrawals_bonus_dashboard", "source_artifact_key": "bonus_dataset", "period_compatibility": "exact"},
    {"key": "betting_dataset", "kind": "prepared_dataset", "required": true, "source_report_code": "cash_operations_dashboard", "source_artifact_key": "betting_dataset", "period_compatibility": "exact"},
    {
      "key": "bet_legs",
      "kind": "uploaded_workbook",
      "label": "Bet Legs Report workbook",
      "required": true,
      "accepted_extensions": ["xlsx"],
      "accepted_mime_types": ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"],
      "worksheet": {"selector": "pending_source_inspection"},
      "canonical_required_fields": ["player_id", "username", "slip_id", "bet_id", "leg_id", "activity_date", "product_type"],
      "source_column_mapping": "pending_source_inspection"
    }
  ],
  "prepared_datasets": [{"key": "master_player_dataset", "format": "parquet", "grain": "exactly_one_record_per_player_id", "schema_version": "1.0.0-draft.1"}],
  "configuration": {
    "timezone": "Indian/Mauritius",
    "include_report_date": null,
    "excluded_dates": [],
    "activity_segment_precedence": null,
    "activity_segment_thresholds": null,
    "dormancy_threshold_days": null,
    "active_bettor_recent_period_days": null,
    "return_rate_denominator": null,
    "value_segmentation_basis": null,
    "value_segmentation_thresholds": null,
    "product_type_mapping": null,
    "bet_legs_deduplication_key": null,
    "frequency_groups": [[1, 1], [2, 4], [5, 9], [10, 19], [20, null]]
  },
  "rendering": {
    "pdf": {"page_size": "A3", "orientation": "landscape", "print_background": true},
    "png": {"width": 2560, "height": 1440, "device_scale_factor": 2},
    "theme": "betnabiso_dark_gold_v1"
  }
}
